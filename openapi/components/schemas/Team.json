{
  "type": "object",
  "required": ["id", "name", "status", "members", "leader_id"],
  "properties": {
    "id": {
      "type": "string",
      "format": "uuid"
    },
    "name": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": ["PENDING", "APPROVED", "BANNED"]
    },
    "members": {
      "type": "array",
      "items": {
        "type": "string",
        "format": "uuid"
      }
    },
    "leader_id": {
      "type": "string",
      "format": "uuid"
    },
    "eliminated_at_round": {
      "$ref": "./Round.json"
    },
    "disqualify_reason": {
      "type": "string"
    },
    "track_id": {
      "type": "string",
      "format": "uuid"
    }
  }
}
