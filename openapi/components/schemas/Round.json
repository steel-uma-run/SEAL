{
  "description": "A round within a hackathon event",
  "type": "object",
  "required": [
    "id",
    "name",
    "description",
    "active_duration",
    "grading_duration",
    "criteria"
  ],
  "properties": {
    "id": {
      "type": "string",
      "format": "uuid"
    },
    "name": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "active_time": {
      "type": "string",
      "format": "date-time"
    },
    "grading_start_time": {
      "type": "string",
      "format": "date-time"
    },
    "active_duration": {
      "type": "integer",
      "format": "int64",
      "description": "In milliseconds"
    },
    "grading_duration": {
      "type": "integer",
      "format": "int64",
      "description": "In milliseconds"
    },
    "criteria": {
      "type": "array",
      "items": {
        "$ref": "./Criteria.json"
      }
    }
  }
}
